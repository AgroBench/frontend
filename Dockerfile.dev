# Imagem de desenvolvimento: Node + Vite (hot-reload).
# O código é montado por volume em /app (ver docker-compose.yaml da raiz).
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000

ENV HOST=0.0.0.0
ENV PORT=3000
ENV CHOKIDAR_USEPOLLING=true

CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port 3000"]
